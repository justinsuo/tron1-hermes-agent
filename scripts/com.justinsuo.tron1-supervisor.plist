<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.justinsuo.tron1-supervisor</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/justinsuo/tron1-selfplay/supervisor.sh</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>DURATION_SEC</key>
        <string>14400</string>   <!-- 4 hours -->
        <key>BATCH_ROUNDS</key>
        <string>20</string>      <!-- smaller batches -->
        <key>BATCH_DELAY</key>
        <string>20</string>      <!-- 20s between episodes -->
        <key>PATH</key>
        <string>/Users/justinsuo/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key>
        <string>/Users/justinsuo</string>
    </dict>

    <!-- Auto-restart DISABLED after repeated Apple Silicon GPU/VRAM
         saturation crashes. To re-enable later set both to true and run:
           launchctl load ~/Library/LaunchAgents/com.justinsuo.tron1-supervisor.plist
         To start a session manually:
           bash ~/tron1-selfplay/supervisor.sh -->
    <key>RunAtLoad</key>
    <false/>
    <key>KeepAlive</key>
    <false/>
    <key>ThrottleInterval</key>
    <integer>60</integer>

    <key>WorkingDirectory</key>
    <string>/Users/justinsuo/tron1-selfplay</string>

    <key>StandardOutPath</key>
    <string>/tmp/tron1-supervisor.out.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/tron1-supervisor.err.log</string>
</dict>
</plist>
